---
import { url, withoutBase } from '../lib/url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = site.description, image = '/og.jpg' } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} – ${site.tagline}`;
// canonical always points at the production domain, also from a preview copy
const canonical = new URL(withoutBase(Astro.url.pathname), site.productionUrl);
// og:image from the site actually being served, so shared preview links get a thumbnail
const ogImage = new URL(url(image), Astro.site);
const isPreview = import.meta.env.PUBLIC_PREVIEW === 'true';

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: site.legalName,
  url: site.productionUrl,
  telephone: site.phoneHref.replace('tel:', ''),
  email: site.email || undefined,
  image: ogImage.toString(),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.postalCode || undefined,
    addressLocality: site.address.city,
    addressCountry: 'PL',
  },
  sameAs: [site.facebook],
};
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#20396f" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
  </head>
  <body>
    <a class="skip-link" href="#tresc">Przejdź do treści</a>

    <div class="grid-lines" aria-hidden="true">
      <div class="container"><span></span><span></span><span></span><span></span><span></span><span></span></div>
    </div>

    <aside class="rail" aria-hidden="true">
      <span class="rail__text"><b>Profil</b> &nbsp;•&nbsp; okna &nbsp;•&nbsp; drzwi &nbsp;•&nbsp; bramy &nbsp;•&nbsp; rolety &nbsp;•&nbsp; parapety</span>
      <span class="rail__line"></span>
    </aside>

    <div class="site">
      <Header />
      <main id="tresc">
        <slot />
      </main>
      <Footer />
    </div>

    <a class="fab" href={site.phoneHref} aria-label={`Zadzwoń: ${site.phone}`}>
      <span class="fab__label">Zadzwoń: {site.phone}</span>
      <span class="fab__btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg></span>
    </a>

    <script>
      // sticky header border
      const header = document.querySelector('.site-header');
      const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // reveal on scroll
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
