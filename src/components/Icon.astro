---
// Line icons. Product icons use a 64x64 grid with a small red ring as the brand accent
// (a nod to the red "o" in the Profil logo); UI icons use a 24x24 grid.
interface Props {
  name: string;
  class?: string;
  label?: string;
}
const { name, class: className = 'icon', label } = Astro.props;

const product: Record<string, string> = {
  okna: `
    <rect x="8" y="12" width="40" height="44" rx="1.5"/>
