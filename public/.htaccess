# Apache config for the static site (ignored by servers that do not use .htaccess)

RewriteEngine On

# always https
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# old WordPress addresses -> new pages
RewriteRule ^drzwi/?$ /drzwi-wewnetrzne/ [L,R=301]
RewriteRule ^parapety/?$ /parapety-wewnetrzne/ [L,R=301]
RewriteRule ^rolety-zaluzje-i-moskitiery/?$ /oslony-wewnetrzne/ [L,R=301]
RewriteRule ^meble-na-wymiar-i-projektowanie-mieszkan/?$ / [L,R=301]
RewriteRule ^wp-(admin|login\.php|content|includes)(/.*)?$ / [L,R=301]
RewriteRule ^feed/?$ / [L,R=301]

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
